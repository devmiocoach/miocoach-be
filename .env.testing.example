# Environment used by the Playwright E2E suite.
#
# The suite runs `migrate:fresh`, so it MUST point at its own database — never
# at the one in .env. Boot the app with it via:
#
#   php artisan serve --env=testing --port=8003
#
# Playwright starts that server itself (see playwright.config.ts) and talks to
# it through E2E_APP_URL.

APP_NAME="MioCoach"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_HOST=localhost
APP_URL=http://127.0.0.1:8003
APP_SLUG=miocoach

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=miocoach_test
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=array
MAIL_MAILER=log
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

DEBUGBAR_ENABLED=false
TELESCOPE_ENABLED=false
PULSE_ENABLED=false

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
