meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/auth/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "cosimo.user@miocoach.it",
    "password": "Y42@1b+^Bj5)",
    "device_type": "mobile",
    "device_name": "iPhone 15 Pro"
  }
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
  res.body.refresh_token: isDefined
  res.body.token_type: eq Bearer
  res.body.user: isDefined
  res.body.user.id: isDefined
  res.body.user.email: isDefined
  res.body.user.role: isDefined
}

script:post-response {
  const body = res.getBody();
  if (body.access_token) {
    bru.setEnvVar('access_token', body.access_token);
    bru.setEnvVar('user_id', body.user.id);
  }
  if (body.two_factor_required) {
    bru.setEnvVar('temp_token', body.temp_token);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
