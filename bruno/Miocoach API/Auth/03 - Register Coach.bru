meta {
  name: Register Coach
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/auth/register/coach
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "name": "Coach Luigi",
    "email": "coach.luigi@example.com",
    "password": "Password123!",
    "password_confirmation": "Password123!",
    "specialization": "Personal Training",
    "bio": "Coach certificato con 10 anni di esperienza"
  }
}

settings {
  encodeUrl: true
}

assert {
  res.status: eq 201
  res.body.status: eq success
  res.body.code: eq REGISTRATION_PENDING_VERIFICATION
  res.body.message: isDefined
}
