meta {
  name: Forgot Password
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/auth/forgot-password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "chef@miocoach.dev"
  }
}

settings {
  encodeUrl: true
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.code: eq PASSWORD_RESET_SENT
  res.body.message: isDefined
}
