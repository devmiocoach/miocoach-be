meta {
  name: Reset Password
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/auth/reset-password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "token": "{{reset_token}}",
    "email": "chef@miocoach.dev",
    "password": "NewPassword123!",
    "password_confirmation": "NewPassword123!"
  }
}

settings {
  encodeUrl: true
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.code: eq PASSWORD_RESET_SUCCESS
  res.body.message: isDefined
}
