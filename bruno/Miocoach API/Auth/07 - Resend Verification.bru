meta {
  name: Resend Verification
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/auth/verify-email/resend
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

settings {
  encodeUrl: true
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.code: eq VERIFICATION_RESENT
  res.body.message: isDefined
}
