meta {
  name: Logout All
  type: http
  seq: 12
}

post {
  url: {{base_url}}/api/v1/auth/logout-all
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

script:post-response {
  bru.setEnvVar('access_token', '');
  bru.setEnvVar('user_id', '');
}

settings {
  encodeUrl: true
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.code: eq ALL_TOKENS_REVOKED
}
