meta {
  name: 2FA Confirm
  type: http
  seq: 15
}

post {
  url: {{base_url}}/api/v1/auth/two-factor/confirm
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "code": "123456"
  }
}

settings {
  encodeUrl: true
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.code: eq TWO_FA_CONFIRMED
}
