meta {
  name: 2FA Disable
  type: http
  seq: 16
}

delete {
  url: {{base_url}}/api/v1/auth/two-factor
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "password": "secretsauce"
  }
}

settings {
  encodeUrl: true
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.code: eq TWO_FA_DISABLED
}
