meta {
  name: Get Current User
  type: http
  seq: 18
}

get {
  url: {{base_url}}/api/v1/auth/me
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{access_token}}
}

auth:bearer {
  token: {{access_token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
