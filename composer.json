{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "miocoach/miocoach",
    "type": "project",
    "description": "A complete modular Laravel foundation for building SaaS applications.",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "cviebrock/eloquent-sluggable": "^13.0",
        "diglactic/laravel-breadcrumbs": "^10.0",
        "filament/actions": "^5.0",
        "filament/filament": "~5.0",
        "filament/forms": "^5.0",
        "filament/infolists": "^5.0",
        "filament/notifications": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "filament/tables": "^5.0",
        "filament/widgets": "^5.0",
        "google/apiclient": "^2.0",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/ai": "^0.4.0",
        "laravel/framework": "^13.0",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "miocoach/auth": "^1.8",
        "miocoach/billing": "^1.7",
        "miocoach/settings": "^1.3",
        "nwidart/laravel-modules": "^13.0",
        "openplain/filament-shadcn-theme": "^1.1",
        "php-ffmpeg/php-ffmpeg": "^1.2",
        "spatie/laravel-navigation": "^1.3",
        "spatie/laravel-permission": "^6.25",
        "spatie/laravel-typescript-transformer": "^2.6",
        "tightenco/ziggy": "^2.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "fakerphp/faker": "^1.23",
        "kkomelin/laravel-translatable-string-exporter": "^1.26",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/telescope": "^5.10",
        "miocoach/laravel-playwright": "^1.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.3",
        "symfony/filesystem": "^7.3"
    },
    "suggest": {
        "miocoach/announcements": "Site-wide announcement banners with scheduling, audience targeting, and cookie-based dismissal",
        "miocoach/auth": "Complete authentication system with login, registration, magic link, password reset, email verification, and OAuth",
        "miocoach/billing": "Subscription management and payment processing via Stripe with checkout, billing portal, and webhooks",
        "miocoach/demo": "Demo module with a variety of example pages and components to jumpstart your development",
        "miocoach/settings": "Account settings pages for managing profile info, avatar, password, and connected social accounts"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "BaconQrCode\\": "vendor/bacon/bacon-qr-code/src",
            "CBOR\\": "vendor/spomky-labs/cbor-php/src",
            "Cose\\": "vendor/web-auth/cose-lib/src",
            "DASPRiD\\Enum\\": "vendor/dasprid/enum/src",
            "Laravel\\Fortify\\": "vendor/laravel/fortify/src",
            "Laravel\\Passkeys\\": "vendor/laravel/passkeys/src",
            "SpomkyLabs\\Pki\\": "vendor/spomky-labs/pki-framework/src",
            "Symfony\\Component\\PropertyAccess\\": "vendor/symfony/property-access",
            "Symfony\\Component\\PropertyInfo\\": "vendor/symfony/property-info",
            "Symfony\\Component\\Serializer\\": "vendor/symfony/serializer",
            "Symfony\\Component\\TypeInfo\\": "vendor/symfony/type-info",
            "Webauthn\\": "vendor/web-auth/webauthn-lib/src"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74,#a3e635\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"npm run dev\" \"php artisan reverb:start\" --names=server,queue,vite,reverb --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade",
            "@php artisan module:generate-types --all --no-interaction --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan vendor:publish --tag=livewire:assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "ide-helper": [
            "@php artisan ide-helper:generate --ansi",
            "@php artisan ide-helper:meta --ansi"
        ],
        "lint": [
            "vendor/bin/pint"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        },
        "merge-plugin": {
            "include": [
                "modules/*/composer.json"
            ]
        },
        "module-dir": "modules",
        "module-type": "miocoach-module"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        },
        "audit": {
            "ignore": ["[PKSA-y2cr-5h3j-g3ys]"]
        }
    },
    "repositories": [
        {"type": "path", "url": "./modules/Auth", "options": {"symlink": true, "versions": {"miocoach/auth": "1.8.1"}}},
        {"type": "path", "url": "./modules/Billing", "options": {"symlink": true, "versions": {"miocoach/billing": "1.7.0"}}},
        {"type": "path", "url": "./modules/Settings", "options": {"symlink": true, "versions": {"miocoach/settings": "1.3.1"}}},
        {"type": "path", "url": "./modules/Users", "options": {"symlink": true, "versions": {"miocoach/users": "1.0.0"}}},
        {"type": "path", "url": "./packages/laravel-playwright", "options": {"symlink": true, "versions": {"miocoach/laravel-playwright": "1.1.0"}}}
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Miocoach",
            "email": "hello@miocoach.dev"
        },
        {
            "name": "Renan Roble",
            "email": "renanroble@gmail.com"
        }
    ],
    "keywords": [
        "laravel starter kit",
        "laravel boilerplate",
        "saas starter kit",
        "saas boilerplate"
    ]
}
